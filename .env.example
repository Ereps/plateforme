# Copier en .env et compléter. Ne jamais commiter .env.
# Les commentaires sont placés AU-DESSUS des variables : docker compose ne tolère pas de commentaire en fin de ligne.

# --- MISP ---
# Adresse du MISP vue depuis le poste (navigateur)
MISP_BASEURL=https://localhost:8443
MISP_ADMIN_EMAIL=admin@admin.test
MISP_ADMIN_PASSWORD=ChangezMoi-Des-La-Premiere-Connexion!
# Clé API MISP : 40 caractères hexadécimaux, à générer AVANT le premier `docker compose up`
# (elle est injectée à l'initialisation du conteneur misp-core via ADMIN_KEY et lue par n8n et osint-tools) :
#   python3 -c "import secrets;print(secrets.token_hex(20))"
MISP_API_KEY=
MISP_ORG=GroupeXX-IT320
MYSQL_ROOT_PASSWORD=changez-moi-root
MYSQL_PASSWORD=changez-moi-misp
REDIS_PASSWORD=changez-moi-redis

# --- LLM (serveur mutualisé donné au tableau) ---
OLLAMA_URL=http://ollama.tp.local:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Sources ---
# Compte gratuit sur otx.alienvault.com
OTX_API_KEY=
OTX_KEYWORDS=ransomware,phishing,france
SHODAN_API_KEY=
# abuse.ch (URLhaus, Feodo Tracker, MalwareBazaar, ThreatFox) exige une Auth-Key depuis le 30 juin 2025
# pour ses API et ses flux : compte gratuit sur https://auth.abuse.ch (voir README, section « Clés API »).
# À renseigner dans MISP : Administration → Server Settings → Plugin → « Plugin.Feed_abusech_auth_key » (ou en-tête Auth-Key du flux).
ABUSECH_AUTH_KEY=

# --- Surveillance (séance 4) ---
WATCH_SECTOR=Manufacturing
WATCH_COUNTRY=FR
# Domaine bac à sable donné au tableau (seule cible autorisée pour dnstwist / nuclei)
SANDBOX_DOMAIN=

# --- OpenCTI (TP 4, sur la VM du groupe : docker compose -f docker-compose.opencti.yml up -d) ---
# Dernière branche 6.x ; OpenCTI 7 (fév. 2026) change la configuration (APP__ENCRYPTION_KEY, xtm-composer, Elasticsearch) : ne pas mélanger.
OPENCTI_VERSION=6.9.29
# Adresse de la VM vue des postes (http://<ip-de-la-vm>:8080) — sert aux liens générés par OpenCTI
OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@groupe.test
OPENCTI_ADMIN_PASSWORD=ChangezMoi-OpenCTI!
# UUID v4 : python3 -c "import uuid;print(uuid.uuid4())"
OPENCTI_ADMIN_TOKEN=
# UUID v4 (clé du endpoint /health utilisée par le healthcheck Compose)
OPENCTI_HEALTHCHECK_ACCESS_KEY=
OPENSEARCH_MEMORY=2g
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=changez-moi-minio-12caracteres
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=changez-moi-rabbit
# UUID v4
CONNECTOR_MITRE_ID=
# UUID v4
CONNECTOR_MISP_ID=
# Adresse du MISP du groupe vue depuis la VM
MISP_BASEURL_FROM_VM=https://<ip-du-poste-misp>:8443
